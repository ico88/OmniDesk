OMNIDESK_DOMAIN=omnidesk.example.com
OMNIDESK_RUSTDESK_PUBLIC_KEY=replace-with-the-public-key-from-id_ed25519.pub
ACME_EMAIL=admin@example.com
ADMIN_EMAIL=admin@example.com
OMNIDESK_PROXY_SUBNET=172.29.84.0/24
OMNIDESK_BIND_ADDRESS=10.0.0.53
OMNIDESK_HTTP_PORT=80
OMNIDESK_HTTPS_PORT=443
OMNIDESK_TOTP_ENABLED=false
# Login email second factor. Requires configured outbound SMTP; leave disabled until explicitly enabled.
OMNIDESK_EMAIL_2FA_ENABLED=false
OMNIDESK_API_IMAGE=omnidesk-api:production
OMNIDESK_DASHBOARD_IMAGE=omnidesk-dashboard:production
OMNIDESK_RETENTION_DELIVERED_OUTBOX_DAYS=180
OMNIDESK_RETENTION_PROCESSED_EMAIL_INTAKES_DAYS=180
OMNIDESK_RETENTION_PENDING_EMAIL_INTAKES_DAYS=30
OMNIDESK_BACKUP_RETENTION_DAYS=0
OMNIDESK_DEVICE_OFFLINE_AFTER_SECONDS=180
OMNIDESK_DEVICE_PRESENCE_POLL_SECONDS=30
